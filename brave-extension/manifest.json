{
  "manifest_version": 3,
  "name": "FLOW \u2014 Reuni\u00f5es Meet",
  "version": "1.1.0",
  "description": "Avisa o servi\u00e7o local FLOW quando voc\u00ea entra ou sai do Google Meet.",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:58376/*",
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "meet.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}